//@version=5
indicator("震荡区识别", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

// ============================================================
// 输入：显示开关
// ============================================================
showShortTerm = input.bool(true, "显示短期震荡", group="显示控制")
showMidTerm   = input.bool(true, "显示中期震荡", group="显示控制")

// ============================================================
// 输入：ATR参数
// ============================================================
atrLen        = input.int(14, "ATR周期", minval=5, group="ATR参数")

// ============================================================
// 输入：短期模式参数
// ============================================================
stBaseMult      = input.float(0.33, "基底/前推进实体比", step=0.05, group="短期模式参数")
stBaseMax       = input.int(8,     "基底最多K线数",   minval=1,  group="短期模式参数")
stConfirmMult   = input.float(3.0, "后推/基底实体倍率", step=0.5, group="短期模式参数")
stLegMult       = input.float(3.0, "推进最小位移(×ATR)", step=0.5, group="短期模式参数")
stBaseRangeMult = input.float(1.0, "基底最大范围(×ATR)", step=0.2, group="短期模式参数")

// ============================================================
// 输入：中期模式参数
// ============================================================
mtPivotLen   = input.int(7,   "摆动点灵敏度",   minval=3, group="中期模式参数")
mtSwingCount = input.int(3,   "同级摆动最少个数", minval=2, group="中期模式参数")
mtSameMult   = input.float(1.5, "同级判定(×ATR)", step=0.1, group="中期模式参数")
showSwLines  = input.bool(true, "显示摆动连接线", group="中期模式参数")

// ============================================================
// K线基础数据
// ============================================================
atrVal    = ta.atr(atrLen)
bodyVal   = math.abs(close - open)
fullRange = high - low
isBull    = close > open

// ============================================================
// 前推参考尺度函数 — 最近8根K线中实体较大的50%的平均值
// ============================================================
calcLegAvgBody() =>
    vals = array.new_float()
    for i = 1 to 8
        array.push(vals, bodyVal[i])
    array.sort(vals)
    avg = 0.0
    for i = 4 to 7
        avg := avg + array.get(vals, i)
    avg / 4.0

// ============================================================
// 摆动点收敛检测函数
// ============================================================
checkSwingsStopped(arr, count, maxDiff) =>
    cnt = array.size(arr)
    if cnt < count
        false
    else
        stopped = true
        refVal = array.get(arr, 0)
        for i = 1 to count - 1
            if math.abs(array.get(arr, i) - refVal) > maxDiff
                stopped := false
        stopped

// ============================================================
// 中期模式 — 持久化存储
// ============================================================
var float[] mtSwHighArr = array.new_float()
var int[]   mtSwHighBar = array.new_int()
var float[] mtSwLowArr  = array.new_float()
var int[]   mtSwLowBar  = array.new_int()

// 震荡区状态（仅用于当前活跃的震荡）
var float mtCurHigh  = na
var float mtCurLow   = na
var int   mtCurStartBar = na
var bool  mtInZone   = false

// 摆动连接线状态
var int   mtLastSwBar   = na    // 上一个摆动点的 bar_index
var float mtLastSwPrice = na    // 上一个摆动点的价格
var bool  mtLastSwIsHi  = na    // 上一个摆动点是否是高点
var line  mtSwLine      = na    // 当前正在画的线

// 当期K线是否在震荡区中（用于 plot fill）
mtFillTop = float(na)
mtFillBot = float(na)

// ============================================================
// 短期模式 — 从推进K线反向查找基底
// ============================================================
if showShortTerm
    legAvg = calcLegAvgBody()
    minBody = legAvg * stBaseMult
    pushMinBody = minBody * stConfirmMult

    if bodyVal >= pushMinBody and bodyVal > 0
        baseHigh  = 0.0
        baseLow   = 0.0
        baseSum   = 0.0
        baseCnt   = 0
        firstBase = false

        for i = 1 to stBaseMax
            isBaseCandle = math.abs(close[i] - open[i]) <= minBody and math.abs(close[i] - open[i]) > 0 and (high[i] - low[i]) <= atrVal * stBaseRangeMult
            if isBaseCandle
                if not firstBase
                    firstBase := true
                    baseHigh := high[i]
                    baseLow  := low[i]
                else
                    baseHigh := math.max(baseHigh, high[i])
                    baseLow  := math.min(baseLow, low[i])
                baseCnt := baseCnt + 1
                baseSum := baseSum + math.abs(close[i] - open[i])
            else
                if i == 1 and baseCnt == 0
                    baseCnt := 0
                break

        if baseCnt >= 1
            baseEndBar = bar_index - 1
            baseStartBar = baseEndBar - baseCnt + 1
            legUp   = close - baseLow
            legDown = baseHigh - close
            if (isBull and legUp >= atrVal * stLegMult) or (not isBull and legDown >= atrVal * stLegMult)
                zCol = isBull ? color.new(#00C853, 85) : color.new(#E84118, 85)
                bCol = isBull ? color.new(#00C853, 50) : color.new(#E84118, 50)
                box.new(baseStartBar, baseHigh, baseEndBar, baseLow, bgcolor=zCol, border_color=bCol, border_width=1)

                lblTxt = isBull ? "短期需求区" : "短期供应区"
                lblY = isBull ? baseLow - atrVal * 0.3 : baseHigh + atrVal * 0.3
                lblSty = isBull ? label.style_label_up : label.style_label_down
                lblCol = isBull ? color.new(#00C853, 60) : color.new(#E84118, 60)
                label.new(bar_index, lblY, text=lblTxt, textcolor=color.black, color=lblCol, style=lblSty, size=size.normal)

// ============================================================
// 中期模式 — 结构级别摆动高低点收敛识别
// ============================================================
if showMidTerm
    // 检测新 swing
    phPrice = ta.pivothigh(high, mtPivotLen, mtPivotLen)
    plPrice = ta.pivotlow(low,   mtPivotLen, mtPivotLen)

    if not na(phPrice)
        curBar = bar_index - mtPivotLen
        curPrice = phPrice
        array.unshift(mtSwHighArr, curPrice)
        array.unshift(mtSwHighBar, curBar)
        if array.size(mtSwHighArr) > 10
            array.pop(mtSwHighArr)
            array.pop(mtSwHighBar)

        // 画摆动连接线
        if showSwLines
            if not na(mtLastSwBar)
                if mtLastSwIsHi
                    // 同方向（高→高），更新末端
                    if not na(mtSwLine)
                        line.set_xy2(mtSwLine, curBar, curPrice)
                else
                    // 方向反转（低→高），画上升段
                    mtSwLine := line.new(mtLastSwBar, mtLastSwPrice, curBar, curPrice,
                     xloc=xloc.bar_index, color=color.new(#26A69A, 80), width=1, style=line.style_solid)
            mtLastSwBar := curBar
            mtLastSwPrice := curPrice
            mtLastSwIsHi := true

    if not na(plPrice)
        curBar = bar_index - mtPivotLen
        curPrice = plPrice
        array.unshift(mtSwLowArr, curPrice)
        array.unshift(mtSwLowBar, curBar)
        if array.size(mtSwLowArr) > 10
            array.pop(mtSwLowArr)
            array.pop(mtSwLowBar)

        // 画摆动连接线
        if showSwLines
            if not na(mtLastSwBar)
                if not mtLastSwIsHi
                    // 同方向（低→低），更新末端
                    if not na(mtSwLine)
                        line.set_xy2(mtSwLine, curBar, curPrice)
                else
                    // 方向反转（高→低），画下降段
                    mtSwLine := line.new(mtLastSwBar, mtLastSwPrice, curBar, curPrice,
                     xloc=xloc.bar_index, color=color.new(#EF5350, 80), width=1, style=line.style_solid)
            mtLastSwBar := curBar
            mtLastSwPrice := curPrice
            mtLastSwIsHi := false

    // ----------------------------------------------------------
    // 绘制所有已完成的震荡区（固定坐标，在最后一根K线统一绘制）
    // ----------------------------------------------------------
    // 注意：因为 Pine 每次重算会清除所有绘图对象，所以每次重算完成时
    // 必须重绘所有已完成和活跃的震荡区

    // ----------------------------------------------------------
    // 活跃震荡区 → plot/fill 实时显示 + 突破时创建 box
    // ----------------------------------------------------------
    if mtInZone
        if not na(mtCurHigh) and not na(mtCurLow)
            mtFillTop := mtCurHigh
            mtFillBot := mtCurLow

            if close > mtCurHigh or close < mtCurLow
                // 突破 → 创建 box（用 bar_index 固定坐标）
                isUp = close > mtCurHigh
                box.new(mtCurStartBar, mtCurHigh, bar_index - 1, mtCurLow,
                 bgcolor=color.new(#7C4DFF, 85), border_color=color.new(#7C4DFF, 50),
                 border_width=1)

                dirTxt = isUp ? "▲ 向上突破" : "▼ 向下突破"
                lblCol = isUp ? color.new(#00C853, 60) : color.new(#E84118, 60)
                lblY_ = isUp ? mtCurHigh - atrVal * 0.5 : mtCurLow + atrVal * 0.5
                lblSty_ = isUp ? label.style_label_up : label.style_label_down
                label.new(bar_index, lblY_, text="中期震荡结束 " + dirTxt,
                 textcolor=color.black, color=lblCol, style=lblSty_, size=size.normal)

                mtInZone := false
                mtCurHigh := na
                mtCurLow := na
                mtCurStartBar := na
                array.clear(mtSwHighArr)
                array.clear(mtSwHighBar)
                array.clear(mtSwLowArr)
                array.clear(mtSwLowBar)

    // ----------------------------------------------------------
    // 不在震荡区中 → 检查能否启动新震荡区
    // ----------------------------------------------------------
    if not mtInZone
        highsStopped = checkSwingsStopped(mtSwHighArr, mtSwingCount, atrVal * mtSameMult)
        lowsStopped  = checkSwingsStopped(mtSwLowArr,  mtSwingCount, atrVal * mtSameMult)

        if highsStopped and lowsStopped
            mtInZone := true

            zoneStart = bar_index
            for i = 0 to mtSwingCount - 1
                zoneStart := math.min(zoneStart, array.get(mtSwHighBar, i))
                zoneStart := math.min(zoneStart, array.get(mtSwLowBar, i))

            zHigh = array.get(mtSwHighArr, 0)
            zLow  = array.get(mtSwLowArr,  0)
            for i = 0 to mtSwingCount - 1
                zHigh := math.max(zHigh, array.get(mtSwHighArr, i))
                zLow  := math.min(zLow,  array.get(mtSwLowArr, i))

            mtCurHigh  := zHigh
            mtCurLow   := zLow
            mtCurStartBar := zoneStart

            mtFillTop := zHigh
            mtFillBot := zLow

            lblY2 = (zHigh + zLow) / 2 + atrVal * 0.5
            label.new(zoneStart, lblY2, text="▼ 中期震荡",
             textcolor=color.black, color=color.new(#7C4DFF, 60),
             style=label.style_label_down, size=size.normal)

// ============================================================
// plot/fill 绘制震荡区（替代 box.new）
// ============================================================
pTop = plot(mtFillTop, "ZoneTop", display=display.none)
pBot = plot(mtFillBot, "ZoneBot", display=display.none)
fill(pTop, pBot, color=color.new(#7C4DFF, 85), title="中期震荡区")
