//@version=5
// 三角形态识别 V3 — 基于 v1 识别骨架 + 0.618 回调必要条件
// 熊大课程: 收敛形态 = 回调到前一段的 0.618 有反应
// 4 触点 (低1 d -> 高1 B -> 低2 L -> 高2 a):
//   段2 回调 >= 段1 的 0.618, 段3 恢复 >= 段2 的 0.618 (不满足不画三角形)
// 不使用 v2 的 hasExtraPivots (内部必须有一对枢轴点) 逻辑
indicator('三角形态识别V3', 'Triangle3', overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ============================================================================
// 1. 参数
// ============================================================================
pivotLen  = input.int(6, '枢轴 Lookback', minval=2, maxval=20, group='枢轴点')
atrLen    = input.int(14, 'ATR 周期', minval=5, maxval=50, group='容差')
atrMult   = input.float(1.0, '容差倍数', minval=0.2, maxval=5.0, step=0.1, group='容差')
queueSize = input.int(6, '回望枢轴点数量', minval=3, maxval=10, group='枢轴点')

// ============================================================================
// 2. ATR + 枢轴点
// ============================================================================
atrVal = ta.atr(atrLen)
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

// ============================================================================
// 3. 类型定义
// ============================================================================
type Pivot
    int bar
    int t
    float price

// ============================================================================
// 4. 持久存储
// ============================================================================
var Pivot[] phArr = array.new<Pivot>()
var Pivot[] plArr = array.new<Pivot>()

var line[]  drawnLines  = array.new<line>()
var label[] drawnLabels = array.new<label>()
var int[]   upKeys      = array.new<int>()
var int[]   dnKeys      = array.new<int>()
var int[]   triKeys     = array.new<int>()

// ============================================================================
// 5. 几何 + 影线工具
// ============================================================================
linePrice(int bar0, float p0, int bar1, float p1, int barX) =>
    float r = p0
    if bar0 != bar1
        r := p0 + (p1 - p0) * (barX - bar0) / (bar1 - bar0)
    r

bodyLowAt(int barIdx) =>
    off = bar_index - barIdx
    math.min(open[off], close[off])

bodyHighAt(int barIdx) =>
    off = bar_index - barIdx
    math.max(open[off], close[off])

lowShadowOverlap(int dBar, float dPrice, int lBar, float lPrice) =>
    dBl = bodyLowAt(dBar)
    lBl = bodyLowAt(lBar)
    math.max(dPrice, lPrice) <= math.min(dBl, lBl)

highShadowOverlap(int dBar, float dPrice, int lBar, float lPrice) =>
    dBh = bodyHighAt(dBar)
    lBh = bodyHighAt(lBar)
    math.min(dPrice, lPrice) >= math.max(dBh, lBh)

fakeBreakLow(int lBar, float dPrice) =>
    lOff = bar_index - lBar
    nOff = lOff - 1
    close[lOff] < open[lOff] and close[nOff] > open[nOff] and close[lOff] < dPrice and close[nOff] > dPrice

fakeBreakHigh(int lBar, float dPrice) =>
    lOff = bar_index - lBar
    nOff = lOff - 1
    close[lOff] > open[lOff] and close[nOff] < open[nOff] and close[lOff] > dPrice and close[nOff] < dPrice

// ============================================================================
// 6. 区间最值 (在枢轴队列里找)
// ============================================================================
lowestLowBetween(int bar1, int bar2) =>
    float bestP = 1e20
    int   bestB = -1
    int   bestT = 0
    sz = array.size(plArr)
    if sz > 0
        for i = 0 to sz - 1
            p = array.get(plArr, i)
            if p.bar > bar1 and p.bar < bar2 and p.price < bestP
                bestP := p.price
                bestB := p.bar
                bestT := p.t
    [bestP, bestB, bestT]

highestHighBetween(int bar1, int bar2) =>
    float bestP = -1e20
    int   bestB = -1
    int   bestT = 0
    sz = array.size(phArr)
    if sz > 0
        for i = 0 to sz - 1
            p = array.get(phArr, i)
            if p.bar > bar1 and p.bar < bar2 and p.price > bestP
                bestP := p.price
                bestB := p.bar
                bestT := p.t
    [bestP, bestB, bestT]

// ============================================================================
// 7. 方向判定
// ============================================================================
// 下边界方向: 1=向上, 2=水平, 3=向下(无效)
classifyDn(int dBar, float dPrice, int lBar, float lPrice) =>
    int dir = 3
    if lowShadowOverlap(dBar, dPrice, lBar, lPrice)
        dir := 2
    else if fakeBreakLow(lBar, dPrice)
        dir := 2
    else if lPrice > dPrice
        dir := 1
    dir

// 上边界方向: 1=下降, 2=水平, 3=上升(无效)
classifyUp(int dBar, float dPrice, int lBar, float lPrice) =>
    int dir = 3
    if highShadowOverlap(dBar, dPrice, lBar, lPrice)
        dir := 2
    else if fakeBreakHigh(lBar, dPrice)
        dir := 2
    else if lPrice < dPrice
        dir := 1
    dir

// ============================================================================
// 8. 颜色 + 名称
// ============================================================================
triColor(int ttype) =>
    color c = color.new(#ffa726, 0)
    if ttype == 0
        c := color.new(#26a69a, 0)
    else if ttype == 1
        c := color.new(#ef5350, 0)
    c

triName(int ttype) =>
    string s = '对称三角'
    if ttype == 0
        s := '上升三角'
    else if ttype == 1
        s := '下降三角'
    s

// ============================================================================
// 9. 去重
// ============================================================================
isUpDrawn(int sBar, int eBar) =>
    key = sBar * 100000 + eBar
    found = false
    sz = array.size(upKeys)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(upKeys, i) == key
                found := true
                break
    found

isDnDrawn(int sBar, int eBar) =>
    key = sBar * 100000 + eBar
    found = false
    sz = array.size(dnKeys)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(dnKeys, i) == key
                found := true
                break
    found

isTriDrawn(int bBar, int dBar, int ttype) =>
    key = bBar * 1000000 + dBar * 10 + ttype
    found = false
    sz = array.size(triKeys)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(triKeys, i) == key
                found := true
                break
    found

// ============================================================================
// 10. 高点触发流程
// ============================================================================
handlePh() =>
    if array.size(phArr) >= 2
        aBar   = array.get(phArr, 0).bar
        aPrice = array.get(phArr, 0).price
        aTime  = array.get(phArr, 0).t
        sz = array.size(phArr)
        tol = atrMult * atrVal
        if not na(tol) and tol > 0
            for k = 1 to sz - 1
                bBar   = array.get(phArr, k).bar
                bPrice = array.get(phArr, k).price
                bTime  = array.get(phArr, k).t
                if bPrice <= aPrice
                    continue
                // 中间不突破
                ok = true
                if k > 1
                    for m = 1 to k - 1
                        mBar   = array.get(phArr, m).bar
                        mPrice = array.get(phArr, m).price
                        lp = linePrice(bBar, bPrice, aBar, aPrice, mBar)
                        if mPrice > lp
                            ok := false
                            break
                if not ok
                    continue
                // 找 L
                [lPrice, lBar, lTime] = lowestLowBetween(bBar, aBar)
                if lBar < 0
                    continue
                // 类型1: 上边界延长 (每个共线 c 画一条 [c, a])
                if k + 1 <= sz - 1
                    for cIdx = k + 1 to sz - 1
                        cBar   = array.get(phArr, cIdx).bar
                        cPrice = array.get(phArr, cIdx).price
                        cTime  = array.get(phArr, cIdx).t
                        if cPrice <= bPrice
                            continue
                        ext = linePrice(bBar, bPrice, aBar, aPrice, cBar)
                        if math.abs(cPrice - ext) <= tol
                            slopeCA = (aPrice - cPrice) / (aBar - cBar)
                            okClose = true
                            for i = cBar to aBar
                                lineVal = cPrice + slopeCA * (i - cBar)
                                if close[bar_index - i] > lineVal
                                    okClose := false
                                    break
                            if okClose
                                if not isUpDrawn(cBar, aBar)
                                    array.push(upKeys, cBar * 100000 + aBar)
                                    array.push(drawnLines, line.new(cTime, cPrice, aTime, aPrice, xloc=xloc.bar_time, color=color.new(#999999, 0), width=1))
                // 类型2: 下边界构建
                if k + 1 <= sz - 1
                    for cIdx = k + 1 to sz - 1
                        cBar   = array.get(phArr, cIdx).bar
                        cPrice = array.get(phArr, cIdx).price
                        [dPrice, dBar, dTime] = lowestLowBetween(cBar, bBar)
                        if dBar < 0
                            continue
                        // d-L 不被其他低点突破
                        dnOk = true
                        plSz = array.size(plArr)
                        if plSz > 0
                            for i = 0 to plSz - 1
                                pp = array.get(plArr, i)
                                if pp.bar > dBar and pp.bar < lBar
                                    lineP = linePrice(dBar, dPrice, lBar, lPrice, pp.bar)
                                    if pp.price < lineP
                                        dnOk := false
                                        break
                        if not dnOk
                            continue
                        // 下边界方向
                        dnDir = classifyDn(dBar, dPrice, lBar, lPrice)
                        if dnDir == 3
                            continue
                        // v3: 0.618 回调必要条件 (低1 d -> 高1 B -> 低2 L -> 高2 a)
                        seg1 = bPrice - dPrice
                        seg2 = bPrice - lPrice
                        seg3 = aPrice - lPrice
                        if seg1 <= 0 or seg2 <= 0 or seg3 <= 0
                            continue
                        if seg2 < 0.618 * seg1 or seg3 < 0.618 * seg2
                            continue
                        ttype = dnDir == 1 ? 2 : 1
                        col = triColor(ttype)
                        // 画上边界 [B, a]
                        if not isUpDrawn(bBar, aBar)
                            array.push(upKeys, bBar * 100000 + aBar)
                            array.push(drawnLines, line.new(bTime, bPrice, aTime, aPrice, xloc=xloc.bar_time, color=col, width=2))
                        // 画下边界 [d, L]
                        if not isDnDrawn(dBar, lBar)
                            array.push(dnKeys, dBar * 100000 + lBar)
                            array.push(drawnLines, line.new(dTime, dPrice, lTime, lPrice, xloc=xloc.bar_time, color=col, width=2))
                        // 标签
                        if not isTriDrawn(bBar, dBar, ttype)
                            array.push(triKeys, bBar * 1000000 + dBar * 10 + ttype)
                            array.push(drawnLabels, label.new(lTime, lPrice, triName(ttype), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.black, 80), textcolor=col, size=size.small))
                        // 下边界延长 (每个共线 e 画一条 [e, L])
                        plSz2 = array.size(plArr)
                        if plSz2 > 0
                            for eIdx = 0 to plSz2 - 1
                                e = array.get(plArr, eIdx)
                                if e.bar >= dBar
                                    continue
                                extOk = false
                                if dnDir == 1
                                    ext = linePrice(dBar, dPrice, lBar, lPrice, e.bar)
                                    extOk := math.abs(e.price - ext) <= tol and e.price < dPrice
                                else
                                    extOk := lowShadowOverlap(e.bar, e.price, dBar, dPrice)
                                if extOk
                                    okClose2 = true
                                    if dnDir == 1
                                        slopeEL = (lPrice - e.price) / (lBar - e.bar)
                                        for i = e.bar to lBar
                                            lineVal = e.price + slopeEL * (i - e.bar)
                                            if close[bar_index - i] < lineVal
                                                okClose2 := false
                                                break
                                    else
                                        level = math.min(dPrice, lPrice)
                                        for i = e.bar to lBar
                                            if close[bar_index - i] < level
                                                okClose2 := false
                                                break
                                    if okClose2
                                        if not isDnDrawn(e.bar, lBar)
                                            array.push(dnKeys, e.bar * 100000 + lBar)
                                            array.push(drawnLines, line.new(e.t, e.price, lTime, lPrice, xloc=xloc.bar_time, color=col, width=2))

// ============================================================================
// 11. 低点触发流程 (对称)
// ============================================================================
handlePl() =>
    if array.size(plArr) >= 2
        aBar   = array.get(plArr, 0).bar
        aPrice = array.get(plArr, 0).price
        aTime  = array.get(plArr, 0).t
        sz = array.size(plArr)
        tol = atrMult * atrVal
        if not na(tol) and tol > 0
            for k = 1 to sz - 1
                bBar   = array.get(plArr, k).bar
                bPrice = array.get(plArr, k).price
                bTime  = array.get(plArr, k).t
                if bPrice >= aPrice
                    continue
                ok = true
                if k > 1
                    for m = 1 to k - 1
                        mBar   = array.get(plArr, m).bar
                        mPrice = array.get(plArr, m).price
                        lp = linePrice(bBar, bPrice, aBar, aPrice, mBar)
                        if mPrice < lp
                            ok := false
                            break
                if not ok
                    continue
                [lPrice, lBar, lTime] = highestHighBetween(bBar, aBar)
                if lBar < 0
                    continue
                // 类型1: 下边界延长
                if k + 1 <= sz - 1
                    for cIdx = k + 1 to sz - 1
                        cBar   = array.get(plArr, cIdx).bar
                        cPrice = array.get(plArr, cIdx).price
                        cTime  = array.get(plArr, cIdx).t
                        if cPrice >= bPrice
                            continue
                        ext = linePrice(bBar, bPrice, aBar, aPrice, cBar)
                        if math.abs(cPrice - ext) <= tol
                            slopeCA = (aPrice - cPrice) / (aBar - cBar)
                            okClose = true
                            for i = cBar to aBar
                                lineVal = cPrice + slopeCA * (i - cBar)
                                if close[bar_index - i] < lineVal
                                    okClose := false
                                    break
                            if okClose
                                if not isDnDrawn(cBar, aBar)
                                    array.push(dnKeys, cBar * 100000 + aBar)
                                    array.push(drawnLines, line.new(cTime, cPrice, aTime, aPrice, xloc=xloc.bar_time, color=color.new(#999999, 0), width=1))
                // 类型2: 上边界构建
                if k + 1 <= sz - 1
                    for cIdx = k + 1 to sz - 1
                        cBar   = array.get(plArr, cIdx).bar
                        cPrice = array.get(plArr, cIdx).price
                        [dPrice, dBar, dTime] = highestHighBetween(cBar, bBar)
                        if dBar < 0
                            continue
                        upOk = true
                        phSz = array.size(phArr)
                        if phSz > 0
                            for i = 0 to phSz - 1
                                pp = array.get(phArr, i)
                                if pp.bar > dBar and pp.bar < lBar
                                    lineP = linePrice(dBar, dPrice, lBar, lPrice, pp.bar)
                                    if pp.price > lineP
                                        upOk := false
                                        break
                        if not upOk
                            continue
                        upDir = classifyUp(dBar, dPrice, lBar, lPrice)
                        if upDir == 3
                            continue
                        // v3: 0.618 回调必要条件 (高1 d -> 低1 B -> 高2 L -> 低2 a)
                        seg1 = dPrice - bPrice
                        seg2 = lPrice - bPrice
                        seg3 = lPrice - aPrice
                        if seg1 <= 0 or seg2 <= 0 or seg3 <= 0
                            continue
                        if seg2 < 0.618 * seg1 or seg3 < 0.618 * seg2
                            continue
                        ttype = upDir == 1 ? 2 : 0
                        col = triColor(ttype)
                        // 画上边界 [d, L]
                        if not isUpDrawn(dBar, lBar)
                            array.push(upKeys, dBar * 100000 + lBar)
                            array.push(drawnLines, line.new(dTime, dPrice, lTime, lPrice, xloc=xloc.bar_time, color=col, width=2))
                        // 画下边界 [B, a]
                        if not isDnDrawn(bBar, aBar)
                            array.push(dnKeys, bBar * 100000 + aBar)
                            array.push(drawnLines, line.new(bTime, bPrice, aTime, aPrice, xloc=xloc.bar_time, color=col, width=2))
                        // 标签
                        if not isTriDrawn(bBar, dBar, ttype)
                            array.push(triKeys, bBar * 1000000 + dBar * 10 + ttype)
                            array.push(drawnLabels, label.new(lTime, lPrice, triName(ttype), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.black, 80), textcolor=col, size=size.small))
                        // 上边界延长
                        phSz2 = array.size(phArr)
                        if phSz2 > 0
                            for eIdx = 0 to phSz2 - 1
                                e = array.get(phArr, eIdx)
                                if e.bar >= dBar
                                    continue
                                extOk = false
                                if upDir == 1
                                    ext = linePrice(dBar, dPrice, lBar, lPrice, e.bar)
                                    extOk := math.abs(e.price - ext) <= tol and e.price > dPrice
                                else
                                    extOk := highShadowOverlap(e.bar, e.price, dBar, dPrice)
                                if extOk
                                    okClose2 = true
                                    if upDir == 1
                                        slopeEL = (lPrice - e.price) / (lBar - e.bar)
                                        for i = e.bar to lBar
                                            lineVal = e.price + slopeEL * (i - e.bar)
                                            if close[bar_index - i] > lineVal
                                                okClose2 := false
                                                break
                                    else
                                        level = math.max(dPrice, lPrice)
                                        for i = e.bar to lBar
                                            if close[bar_index - i] > level
                                                okClose2 := false
                                                break
                                    if okClose2
                                        if not isUpDrawn(e.bar, lBar)
                                            array.push(upKeys, e.bar * 100000 + lBar)
                                            array.push(drawnLines, line.new(e.t, e.price, lTime, lPrice, xloc=xloc.bar_time, color=col, width=2))

// ============================================================================
// 12. 主逻辑
// ============================================================================
if not na(ph)
    newPivot = Pivot.new(bar_index - pivotLen, time[pivotLen], high[pivotLen])
    array.unshift(phArr, newPivot)
    if array.size(phArr) > queueSize
        array.pop(phArr)
    handlePh()

if not na(pl)
    newPivot = Pivot.new(bar_index - pivotLen, time[pivotLen], low[pivotLen])
    array.unshift(plArr, newPivot)
    if array.size(plArr) > queueSize
        array.pop(plArr)
    handlePl()

// ============================================================================
// 13. 首次加载清理
// ============================================================================
if barstate.isfirst
    lineSz = array.size(drawnLines)
    if lineSz > 0
        for i = 0 to lineSz - 1
            line.delete(array.get(drawnLines, i))
        array.clear(drawnLines)
    labelSz = array.size(drawnLabels)
    if labelSz > 0
        for i = 0 to labelSz - 1
            label.delete(array.get(drawnLabels, i))
        array.clear(drawnLabels)
    array.clear(upKeys)
    array.clear(dnKeys)
    array.clear(triKeys)
